<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Light palette. Keys must match Dark.xaml. -->
    <SolidColorBrush x:Key="WindowBg" Color="#F3F4F6" />
    <SolidColorBrush x:Key="SurfaceBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBg" Color="#F9FAFB" />
    <SolidColorBrush x:Key="InputBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlBg" Color="#FFFFFF" />
    <SolidColorBrush x:Key="ControlHoverBg" Color="#EEF2F7" />
    <SolidColorBrush x:Key="ControlPressedBg" Color="#E2E8F0" />
    <SolidColorBrush x:Key="TextBrush" Color="#111827" />
    <SolidColorBrush x:Key="SubtleTextBrush" Color="#4B5563" />
    <SolidColorBrush x:Key="DisabledTextBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="BorderStrongBrush" Color="#9CA3AF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="SelectionBg" Color="#DBEAFE" />
    <SolidColorBrush x:Key="HeaderBg" Color="#1F2937" />
    <SolidColorBrush x:Key="HeaderTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="HeaderSubTextBrush" Color="#D1D5DB" />
    <SolidColorBrush x:Key="HeaderCellBg" Color="#F3F4F6" />
    <SolidColorBrush x:Key="StatusBg" Color="#E5E7EB" />
    <SolidColorBrush x:Key="ScrollTrackBrush" Color="#F3F4F6" />
    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#C4C8CF" />
    <SolidColorBrush x:Key="GoodBrush" Color="#15803D" />
    <SolidColorBrush x:Key="BadBrush" Color="#B91C1C" />
</ResourceDictionary>
